# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional. Set to a test server's ID and slash commands sync to that server
# instantly instead of globally (global sync can take up to an hour to appear).
#
# The two are exclusive on purpose: Discord merges a guild's commands with the
# global set, so publishing both would show every command twice. Setting this
# retracts the global set, and unsetting it retracts the guild copy — so the
# switch is just this line, in either direction, followed by a restart.
#
# While it is set, the bot has no commands in any *other* server it is in.
# Leave it unset in production.
DEV_GUILD_ID=

# Optional. Where the SQLite database lives. Default: data/avwx.db
DB_PATH=

# Optional. The configurator site that /avwx config edit links to. Point it at
# http://localhost:8000/ while working on site/ locally.
# Default: https://stellarhopper.github.io/avwx-bot/
CONFIG_SITE_URL=

# Optional. Sent with every weather API request; api.weather.gov requires one
# with a way to contact the operator.
HTTP_USER_AGENT=

# Optional: the club chat (conversations with Claude). Needs all three of
# ANTHROPIC_API_KEY, CHAT_GUILD_IDS, and a server that switches chat on in
# its config. Each answer costs API credit, so only the servers listed here
# can use it, whatever their own config says.
ANTHROPIC_API_KEY=
# Comma-separated server IDs.
CHAT_GUILD_IDS=
# Where aircraft profiles and manuals live. Default: club/ beside the database.
CLUB_DIR=
# How hard Claude thinks: low, medium (default), high, xhigh or max.
CHAT_EFFORT=
